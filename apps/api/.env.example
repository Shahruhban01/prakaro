# Server Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database (MySQL 8+)
DATABASE_URL="mysql://prakaro_user:prakaro_password@localhost:3306/prakaro_db"

# Better Auth Configuration
BETTER_AUTH_SECRET="your_32_char_minimum_random_secret_key_here"
BETTER_AUTH_URL="http://localhost:3000"

# External APIs
# Google Places API (New) key. Required for parking discovery (GET /api/v1/parking/nearby)
GOOGLE_PLACES_API_KEY=""

# Parking Intelligence (server only). Limits are Prakaro settings.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
AI_VERIFICATION_ENABLED=false
AI_SHADOW_MODE=true
AI_MAX_CALLS_PER_DAY=50
AI_MAX_CONCURRENT_REQUESTS=2
AI_REQUEST_TIMEOUT_MS=4000

PARKING_INTELLIGENCE_DISPLAY_ENABLED=false
PARKING_INTELLIGENCE_FILTERING_ENABLED=false
PARKING_INTELLIGENCE_DEFAULT_MODE=ALL_CANDIDATES
PARKING_INTELLIGENCE_REQUIRE_HUMAN_REVIEW=true
# Comma-delimited Better Auth user IDs authorized to run the internal review CLI.
PARKING_REVIEW_ADMIN_IDS=
