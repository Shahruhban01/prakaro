{
  "name": "prakaro-api",
  "version": "0.1.0",
  "private": true,
  "description": "Prakaro Backend API Service",
  "main": "dist/server.js",
  "scripts": {
    "dev:intelligence": "tsx src/dev-intelligence.ts",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:validate": "prisma validate",
    "test": "tsx --import ./tests/setup-env.mjs --test --test-concurrency=1 tests/health.test.ts tests/parking.test.ts tests/auth-and-cloud.test.ts tests/parking-photos.test.ts tests/intelligence.test.ts tests/intelligence.mysql.test.ts tests/intelligence-policy.test.ts tests/moderation.test.ts tests/identity-security.test.ts tests/workforce.test.ts tests/attendance.test.ts tests/continuous-moderation.test.ts tests/analytics.test.ts tests/qa.test.ts tests/policy.test.ts tests/operations.test.ts",
    "intelligence:evaluate": "tsx src/modules/intelligence/intelligence.evaluate.ts",
    "intelligence:review": "tsx src/modules/intelligence/intelligence.review-cli.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.2.0",
    "@fastify/rate-limit": "10.3.0",
    "@google/genai": "2.32.0",
    "@prisma/client": "^5.22.0",
    "better-auth": "^1.7.26",
    "dotenv": "^16.4.5",
    "fastify": "5.12.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^20.17.6",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
